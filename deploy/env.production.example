# RockerPilates - exemplo de variaveis para producao
# Copie para .env no servidor e preencha os valores reais fora do Git.

POSTGRES_DB=usuarios_db
POSTGRES_USER=rocker_prod
DB_USERNAME=rocker_prod

USUARIOS_DB_URL=jdbc:postgresql://postgres:5432/usuarios_db
GERENCIADOR_DB_URL=jdbc:postgresql://postgres:5432/gerenciador_db

JWT_EXPIRATION=86400000
JWT_ALUNO_EXPIRATION=86400000

USUARIOS_URL=http://usuarios-service:8081
GERENCIADOR_URL=http://gerenciador-service:8082
BFF_INTERNAL_URL=http://bff-pilates:8080

APP_MODE=v1
NEXT_PUBLIC_APP_MODE=v1
NEXT_PUBLIC_ENABLE_FUTURE_ADMIN=false

# O cliente acessa o BFF pelo mesmo dominio, em /bff, via Nginx.
NEXT_PUBLIC_BFF_URL=https://rockerpilates.com

APP_COOKIE_SECURE=true
APP_CORS_ALLOWED_ORIGINS=https://rockerpilates.com,https://www.rockerpilates.com
APP_SECURITY_HSTS_ENABLED=false

SPRING_PROFILES_ACTIVE=prod
UPLOAD_DIR=uploads
